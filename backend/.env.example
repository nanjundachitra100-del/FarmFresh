# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# x402 / Algorand Testnet payment settings (backend-only)
# CAIP-2 Algorand Testnet network identifier — do not change
ALGORAND_NETWORK=algorand:SGO1GKSzyE7IEPItTxCByw9x8FmnrCDe
# Algorand Testnet address that receives USDC payments for customer orders
AVM_ADDRESS=
# x402 facilitator URL
X402_FACILITATOR_URL=https://x402.org/facilitator

# M2M Delivery Optimizer x402 payment settings
# The 25-word Algorand mnemonic for the backend wallet that pays M2M service fees.
# KEEP THIS SECRET — never put in frontend code or Vite variables.
# Fund this address with Algorand Testnet USDC (asset 10458941) before use.
# Get testnet USDC from: https://testnet.folks.finance/ or https://dispenser.testnet.aws.algodev.network/
M2M_ALGORAND_MNEMONIC=

# Optional: Algorand address that RECEIVES the M2M service payment.
# Defaults to AVM_ADDRESS if not set.
M2M_RECEIVER_ADDRESS=

# Optional: price in USD that the M2M delivery optimizer charges per call.
# Defaults to 0.10 (= 0.10 USDC) if not set.
M2M_SERVICE_PRICE=0.10

# Supabase Server-Side Configuration (Keep service role key secret!)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Backend self-referencing URL for M2M service calls (used by m2mClient.js)
# Local dev: leave as http://localhost:5000
# Vercel: set to your deployed backend URL, e.g. https://farmfresh-backend-nine.vercel.app
BACKEND_URL=http://localhost:5000


# If not set, the AI assistant falls back to regex parsing.
GEMINI_API_KEY=
