# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# x402 / Algorand Testnet payment settings (backend-only)
# Use the CAIP-2 Algorand Testnet network identifier
ALGORAND_NETWORK=algorand:SGO1GKSzyE7IEPItTxCByw9x8FmnrCDexi9/cOUJOiI=
# Your Algorand Testnet address that receives USDC payments
AVM_ADDRESS=
# Use the Algorand-compatible x402 facilitator for Testnet validation.
# Configure this value per environment when switching networks.
X402_FACILITATOR_URL=https://facilitator.goplausible.xyz

# Supabase Server-Side Configuration (Keep service role key secret!)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
